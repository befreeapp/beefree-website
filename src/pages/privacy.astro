---
import Base from '../layouts/Base.astro';
// Single-sourced from the project's privacy-policy.md (copied into src/content).
// Astro renders the markdown to a <Content /> component at build time.
import { Content } from '../content/privacy-policy.md';
---

<Base
  title="Privacy Policy — Befree"
  description="How Befree protects your data: local-first, encrypted, no ads, never sold, and deletable any time. Read our full policy."
  ogType="article"
>
  <article class="container-prose py-12">
    <h1 class="sr-only">BeFree Privacy Policy</h1>
    <div class="prose-befree">
      <Content />
    </div>
  </article>
</Base>
