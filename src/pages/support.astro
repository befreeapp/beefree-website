---
import Base from '../layouts/Base.astro';
import FullStop from '../components/FullStop.astro';

const faqs = [
  {
    q: 'Is BeFree really free?',
    a: 'Yes. The core app is free, with no ads. An optional Plus tier adds unlimited AI chat, app & content blocking, and partner check-ins, but you never need it to use BeFree.',
  },
  {
    q: 'Does BeFree have an AI accountability partner?',
    a: 'Yes — BeFree gives you a supportive AI accountability partner you name and can talk to any time. It offers a gentle nudge when you go quiet and a kind word after a slip, never judgement.',
  },
  {
    q: 'Is BeFree an app blocker?',
    a: 'BeFree includes a full app blocker as part of BeFree Plus: block the apps that pull you in on a schedule or by place, with an on-device adult-content filter and an optional strict mode.',
  },
  {
    q: 'Can BeFree help with phone addiction?',
    a: 'BeFree is a supportive tool for reducing compulsive phone use — doomscrolling, social media, adult content, and games. It is not medical treatment, but the AI accountability partner, daily check-ins, and app blocker are designed to help you build gentler habits.',
  },
  {
    q: 'Is my data private?',
    a: 'Your check-ins, chats, streak, and blocking rules stay on your device by default. We never sell your data or use it for advertising. See the Privacy Policy for the full detail.',
  },
  {
    q: 'Is BeFree treatment or medical advice?',
    a: "No. BeFree is a supportive tool, not medical treatment, and it doesn't give clinical advice. If you need care, please reach out to a qualified professional.",
  },
  {
    q: 'Which phones does it support?',
    a: 'BeFree is available now on Android via Google Play, with iOS planned later.',
  },
];

const crisisLines = [
  {
    region: 'UK & Republic of Ireland',
    name: 'Samaritans',
    detail: 'Call 116 123 — free, 24/7.',
    href: 'tel:116123',
    action: 'Call 116 123',
  },
  {
    region: 'United States',
    name: '988 Suicide & Crisis Lifeline',
    detail: 'Call or text 988 — free, 24/7.',
    href: 'tel:988',
    action: 'Call or text 988',
  },
  {
    region: 'Anywhere else',
    name: 'Find a Helpline',
    detail: 'Free, confidential support lines for your country.',
    href: 'https://findahelpline.com',
    action: 'findahelpline.com',
  },
];

const faqSchema = {
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---

<Base
  title="Support & crisis resources — Befree"
  description="Get help with Befree, browse common questions, and find free 24/7 crisis lines including Samaritans 116 123 and US 988."
  schema={faqSchema}
>
  <div class="container-prose py-12">
    <h1 class="reveal text-4xl sm:text-5xl">We're here to help<FullStop /></h1>
    <p class="mt-4 max-w-xl text-soft">
      Questions, feedback, or something not working? Reach out — and if you need support
      right now, the crisis resources below are always free and always open.
    </p>

    <!-- Contact -->
    <section class="reveal mt-10">
      <h2 class="text-2xl">Contact us<FullStop /></h2>
      <p class="mt-3 text-soft">
        Email
        <a
          href="mailto:info@befreeapp.net"
          class="font-medium text-teal underline underline-offset-2 hover:text-forest"
          >info@befreeapp.net</a
        >. We read everything and reply with care.
      </p>
    </section>

    <!-- Crisis resources -->
    <section id="crisis" class="reveal mt-12 scroll-mt-24">
      <h2 class="text-2xl">In crisis? Get help now<FullStop /></h2>
      <p class="mt-3 max-w-xl text-soft">
        If you're in immediate danger, please contact your local emergency services. For
        free, confidential support:
      </p>
      <div class="mt-6 grid grid-cols-1 gap-4 sm:grid-cols-3">
        {
          crisisLines.map((c) => (
            <div class="rounded-3xl border border-hairline bg-white/70 p-5 shadow-card">
              <p class="text-xs font-semibold uppercase tracking-wide text-sage">
                {c.region}
              </p>
              <h3 class="mt-1 text-lg">{c.name}</h3>
              <p class="mt-1 text-sm text-soft">{c.detail}</p>
              <a
                href={c.href}
                class="mt-3 inline-block font-semibold text-terracotta underline underline-offset-2 hover:text-coral"
                target={c.href.startsWith('http') ? '_blank' : undefined}
                rel={c.href.startsWith('http') ? 'noopener noreferrer' : undefined}
              >
                {c.action}
              </a>
            </div>
          ))
        }
      </div>
    </section>

    <!-- FAQ -->
    <section class="reveal mt-12">
      <h2 class="text-2xl">Common questions<FullStop /></h2>
      <dl class="mt-6 space-y-5">
        {
          faqs.map((f) => (
            <div class="rounded-3xl border border-hairline bg-white/60 p-5">
              <dt class="font-semibold text-forest">{f.q}</dt>
              <dd class="mt-1 text-sm leading-relaxed text-soft">{f.a}</dd>
            </div>
          ))
        }
      </dl>
    </section>
  </div>
</Base>
