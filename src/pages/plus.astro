---
import Base from '../layouts/Base.astro';
import FullStop from '../components/FullStop.astro';
import CtaButtons from '../components/CtaButtons.astro';
import Sprout from '../components/Sprout.astro';
import BefreePlusLockup from '../components/BefreePlusLockup.astro';
import FilmPlayer from '../components/FilmPlayer.astro';
import Curve from '../components/Curve.astro';
import { PLUS_PRICES, PLUS_YEARLY_SAVING, PLUS_BENEFITS, FREE_FEATURES } from '../data/plus';

const monthly = PLUS_PRICES.monthly.replace('£', '');
const yearly = PLUS_PRICES.yearly.replace('£', '');
const plusSchema = {
  '@type': 'SoftwareApplication',
  name: 'Befree Plus',
  operatingSystem: 'Android',
  applicationCategory: 'HealthApplication',
  url: new URL('/plus', Astro.site!).href,
  description:
    'Befree Plus adds a full app blocker and content filter, unlimited AI chat, and partner check-ins to the free Befree app.',
  publisher: { '@id': new URL('/#org', Astro.site!).href },
  offers: [
    { '@type': 'Offer', name: 'Monthly', price: monthly, priceCurrency: 'GBP' },
    { '@type': 'Offer', name: 'Yearly', price: yearly, priceCurrency: 'GBP' },
  ],
};
---

<Base
  title="Befree Plus — app blocker, content filter & AI chat"
  description="Befree Plus adds a full app blocker and content filter, unlimited AI chat, and partner check-ins — from £3.99/month."
  schema={plusSchema}
>
  <!-- Hero -->
  <section class="paper container-prose pt-6 sm:pt-10">
    <p class="eyebrow reveal">Optional BeFree Plus</p>
    <div class="reveal mt-3" style="--reveal-delay:60ms">
      <BefreePlusLockup size="h-12" />
    </div>
    <h1 class="reveal mt-4 text-5xl leading-[1.02] sm:text-6xl" style="--reveal-delay:120ms">
      Go further, if you want<FullStop />
    </h1>
    <p class="reveal mt-5 max-w-2xl text-lg leading-relaxed text-soft sm:text-xl" style="--reveal-delay:180ms">
      BeFree is free — and stays free. When you're ready for deeper support, Plus unlocks a
      few extra tools to help you stay on track, from
      <span class="font-semibold text-forest">{PLUS_PRICES.monthly}/month</span>.
    </p>
  </section>

  <!-- Free vs Plus -->
  <section class="container-prose py-12 sm:py-14">
    <div class="grid gap-6 lg:grid-cols-2">
      <!-- Free -->
      <div class="reveal rounded-3xl border border-hairline bg-white/70 p-7 shadow-card">
        <div class="flex items-center gap-2">
          <Sprout class="h-7 w-auto text-teal" />
          <h2 class="text-2xl">Always free<FullStop /></h2>
        </div>
        <p class="mt-2 text-sm text-soft">The heart of BeFree, with no paywall and no ads.</p>
        <ul class="mt-5 space-y-3">
          {
            FREE_FEATURES.map((f) => (
              <li class="flex items-start gap-2 text-[0.95rem] text-ink/90">
                <span class="mt-0.5 text-teal" aria-hidden="true">✓</span>
                <span>{f}</span>
              </li>
            ))
          }
        </ul>
      </div>

      <!-- Plus -->
      <div class="reveal rounded-3xl border-2 border-teal bg-mist/40 p-7 shadow-soft" style="--reveal-delay:120ms">
        <div class="flex items-center justify-between">
          <h2 class="text-2xl">With Plus<FullStop /></h2>
          <span class="rounded-full bg-teal px-3 py-1 text-xs font-semibold text-cream">
            from {PLUS_PRICES.monthly}/mo
          </span>
        </div>
        <p class="mt-2 text-sm text-soft">Everything in free, plus:</p>
        <ul class="mt-5 space-y-4">
          {
            PLUS_BENEFITS.map((b) => (
              <li class="flex items-start gap-3">
                <span class="text-2xl" aria-hidden="true">{b.icon}</span>
                <span>
                  <span class="block font-semibold text-forest">{b.title}</span>
                  <span class="mt-0.5 block text-sm leading-relaxed text-soft">{b.body}</span>
                </span>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  <Curve fill="#0F3D39" />

  <!-- The Plus film -->
  <section class="paper bg-forest text-cream">
    <div
      class="container-prose py-12 sm:py-16 lg:grid lg:grid-cols-[1fr_auto] lg:items-center lg:gap-14"
    >
      <div class="reveal">
        <p class="eyebrow eyebrow--onForest">Watch</p>
        <h2 class="mt-3 text-3xl text-cream sm:text-4xl">
          Your time. Your boundaries<FullStop />
        </h2>
        <p class="mt-4 max-w-md leading-relaxed text-mist/80">
          A closer look at what Plus adds: app and content blocking on your schedule or by
          place, unlimited chat with your companion, and a warm check-in at the time of day
          you find hardest.
        </p>
      </div>
      <div class="reveal mt-8 lg:mt-0" style="--reveal-delay:120ms">
        <FilmPlayer
          src="/assets/film-plus.mp4"
          poster="/assets/film-plus-poster.webp"
          label="BeFree Plus — a 33 second film"
          caption="33 seconds · with sound"
        />
      </div>
    </div>
  </section>

  <div class="bg-forest">
    <Curve fill="#FBF6EC" flip />
  </div>

  <!-- Pricing -->
  <section class="container-prose pb-4 pt-12 sm:pt-14">
    <h2 class="text-3xl sm:text-4xl">Simple pricing<FullStop /></h2>
    <p class="mt-3 max-w-xl text-soft">
      Two ways to pay — whichever suits you. Billed through Google Play; cancel any time
      from your store account.
    </p>
    <div class="mt-8 grid gap-5 sm:grid-cols-2">
      <!-- Monthly -->
      <div class="reveal rounded-3xl border border-hairline bg-white/70 p-7 shadow-card">
        <p class="text-sm font-semibold uppercase tracking-wide text-soft">Monthly</p>
        <p class="mt-2">
          <span class="font-display text-4xl text-forest">{PLUS_PRICES.monthly}</span>
          <span class="text-soft"> / month</span>
        </p>
        <p class="mt-2 text-sm text-soft">Flexible — stop whenever you like.</p>
      </div>

      <!-- Yearly -->
      <div class="reveal relative rounded-3xl border-2 border-teal bg-mist/40 p-7 shadow-soft" style="--reveal-delay:120ms">
        <span
          class="absolute right-5 top-5 rounded-full bg-terracotta px-3 py-1 text-xs font-semibold text-cream"
        >
          Save {PLUS_YEARLY_SAVING}
        </span>
        <p class="text-sm font-semibold uppercase tracking-wide text-soft">Yearly</p>
        <p class="mt-2">
          <span class="font-display text-4xl text-forest">{PLUS_PRICES.yearly}</span>
          <span class="text-soft"> / year</span>
        </p>
        <p class="mt-2 text-sm text-soft">Best value for sticking with it.</p>
      </div>
    </div>

    <div class="mt-8">
      <CtaButtons />
    </div>
  </section>

  <!-- Honest notes -->
  <section class="container-prose py-12 sm:py-14">
    <div class="rounded-3xl border border-hairline bg-cream p-6 text-sm leading-relaxed text-soft">
      <p>
        <span class="font-semibold text-forest">A few honest notes.</span> Plus is entirely
        optional — BeFree's core is free forever, and the crisis helpline is never gated.
        App &amp; content blocking is available on Android first (iOS is on the way), uses a
        private on-device filter, and asks only for the permissions each feature needs — all
        revocable any time. Payments are handled by Google Play; we never see your card
        details.
      </p>
    </div>
  </section>

  <!-- Closing CTA -->
  <section class="reveal container-prose pb-16 text-center">
    <Sprout class="mx-auto mb-5 h-12 w-auto text-forest" />
    <h2 class="text-3xl sm:text-4xl">Free to start, today<FullStop /></h2>
    <p class="mx-auto mt-4 max-w-md text-soft">
      Download BeFree and use it free. Upgrade to Plus from inside the app whenever it feels
      right.
    </p>
    <div class="mt-8">
      <CtaButtons align="center" />
    </div>
  </section>
</Base>
