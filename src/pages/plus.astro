---
import Base from '../layouts/Base.astro';
import FullStop from '../components/FullStop.astro';
import CtaButtons from '../components/CtaButtons.astro';
import Sprout from '../components/Sprout.astro';
import BefreePlusLockup from '../components/BefreePlusLockup.astro';
import FilmPlayer from '../components/FilmPlayer.astro';
import Curve from '../components/Curve.astro';
import { PLUS_PRICES, PLUS_YEARLY_SAVING, PLUS_BENEFITS, FREE_FEATURES } from '../data/plus';

const monthly = PLUS_PRICES.monthly.replace('£', '');
const yearly = PLUS_PRICES.yearly.replace('£', '');
const plusSchema = {
  '@type': 'SoftwareApplication',
  name: 'Befree Plus',
  operatingSystem: 'Android',
  applicationCategory: 'HealthApplication',
  url: new URL('/plus', Astro.site!).href,
  description:
    'Befree Plus adds a full app blocker and content filter, unlimited AI chat, and partner check-ins to the free Befree app.',
  publisher: { '@id': new URL('/#org', Astro.site!).href },
  offers: [
    { '@type': 'Offer', name: 'Monthly', price: monthly, priceCurrency: 'GBP' },
    { '@type': 'Offer', name: 'Yearly', price: yearly, priceCurrency: 'GBP' },
  ],
};
---

<Base
  title="Befree Plus — app blocker, content filter & AI chat"
  description="Befree Plus adds a full app blocker and content filter, unlimited AI chat, and partner check-ins — from £3.99/month."
  schema={plusSchema}
>
  <!-- Hero — the campaign's "Go further, if you want" card: forest, the
       statement, a bubble listing what Plus adds, the Plus film on a disc. -->
  <section class="paper relative overflow-hidden bg-forest text-cream">
    <span
      class="pointer-events-none absolute -right-20 top-[46%] h-[20rem] w-[20rem] rounded-full bg-terracotta sm:-right-24 sm:h-[28rem] sm:w-[28rem] lg:-right-36 lg:top-[16%] lg:h-[34rem] lg:w-[34rem]"
      aria-hidden="true"></span>
    <div
      class="container-prose relative pb-14 pt-8 sm:pt-12 lg:grid lg:grid-cols-[1.15fr_0.85fr] lg:items-center lg:gap-x-8 lg:pb-20 lg:pt-16"
    >
      <div>
        <p class="eyebrow eyebrow--onForest reveal">Optional BeFree Plus</p>
        <div class="reveal mt-4" style="--reveal-delay:60ms">
          <BefreePlusLockup size="h-9" tone="cream" />
        </div>
        <h1 class="display-xl reveal mt-5 max-w-[10ch] text-cream" style="--reveal-delay:120ms">
          Go further, if you want<FullStop />
        </h1>
        <p class="lead reveal mt-6 max-w-md text-mist/85" style="--reveal-delay:180ms">
          BeFree is free — and stays free. When you’re ready for deeper support, Plus
          unlocks a few extra tools, from
          <span class="font-semibold text-cream">{PLUS_PRICES.monthly}/month</span>.
        </p>
        <div class="bubble reveal mt-9 max-w-md" style="--reveal-delay:240ms">
          <ul class="space-y-1.5 text-lg text-forest">
            {PLUS_BENEFITS.map((b) => <li>{b.title}</li>)}
          </ul>
        </div>
      </div>
      <div class="reveal relative mt-14 lg:mt-0 lg:justify-self-end" style="--reveal-delay:200ms">
        <FilmPlayer
          size="large"
          tone="onForest"
          src="/assets/film-plus.mp4"
          poster="/assets/film-plus-poster.webp"
          label="BeFree Plus — a 33 second film"
          caption="33 seconds · with sound"
        />
      </div>
    </div>
  </section>

  <div class="bg-forest">
    <Curve fill="#FBF6EC" flip />
  </div>

  <!-- Free vs Plus — two flat colour blocks -->
  <section class="container-prose py-10 sm:py-14">
    <div class="grid gap-5 lg:grid-cols-2">
      <div class="reveal rounded-[2rem] bg-mist/70 p-7 sm:p-9">
        <div class="flex items-center gap-3">
          <Sprout class="h-8 w-auto text-teal" />
          <h2 class="text-2xl sm:text-3xl">Always free<FullStop /></h2>
        </div>
        <p class="mt-3 text-soft">The heart of BeFree, with no paywall and no ads.</p>
        <ul class="mt-6 space-y-3">
          {
            FREE_FEATURES.map((f) => (
              <li class="flex items-start gap-3 text-[0.95rem] text-ink/90">
                <span class="mt-2 h-1.5 w-1.5 flex-none rounded-full bg-terracotta" aria-hidden="true" />
                <span>{f}</span>
              </li>
            ))
          }
        </ul>
      </div>

      <div class="reveal paper rounded-[2rem] bg-forest p-7 text-cream sm:p-9" style="--reveal-delay:120ms">
        <div class="flex items-center justify-between gap-4">
          <h2 class="text-2xl text-cream sm:text-3xl">With Plus<FullStop /></h2>
          <span class="rounded-full bg-amber px-3 py-1 text-xs font-semibold text-forest">
            from {PLUS_PRICES.monthly}/mo
          </span>
        </div>
        <p class="mt-3 text-mist/80">Everything in free, plus:</p>
        <ul class="mt-6 space-y-5">
          {
            PLUS_BENEFITS.map((b, i) => (
              <li>
                <p class="eyebrow eyebrow--onForest">0{i + 1}</p>
                <p class="mt-1 font-semibold text-cream">{b.title}</p>
                <p class="mt-0.5 text-sm leading-relaxed text-mist/75">{b.body}</p>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  <!-- Pricing -->
  <section class="container-prose py-10 sm:py-14">
    <p class="eyebrow reveal">Pricing</p>
    <h2 class="display-lg reveal mt-4" style="--reveal-delay:60ms">Simple pricing<FullStop /></h2>
    <p class="lead reveal mt-5 max-w-md text-ink/80" style="--reveal-delay:120ms">
      Two ways to pay — whichever suits you. Billed through Google Play; cancel any time
      from your store account.
    </p>
    <div class="mt-9 grid gap-5 sm:grid-cols-2">
      <div class="reveal rounded-[2rem] bg-mist/70 p-7 sm:p-9">
        <p class="eyebrow">Monthly</p>
        <p class="mt-3">
          <span class="font-display text-4xl text-forest">{PLUS_PRICES.monthly}</span>
          <span class="text-soft"> / month</span>
        </p>
        <p class="mt-3 text-sm text-soft">Flexible — stop whenever you like.</p>
      </div>

      <div class="reveal paper relative rounded-[2rem] bg-forest p-7 text-cream sm:p-9" style="--reveal-delay:120ms">
        <span class="absolute right-6 top-6 rounded-full bg-amber px-3 py-1 text-xs font-semibold text-forest">
          Save {PLUS_YEARLY_SAVING}
        </span>
        <p class="eyebrow eyebrow--onForest">Yearly</p>
        <p class="mt-3">
          <span class="font-display text-4xl text-cream">{PLUS_PRICES.yearly}</span>
          <span class="text-mist/75"> / year</span>
        </p>
        <p class="mt-3 text-sm text-mist/75">Best value for sticking with it.</p>
      </div>
    </div>

    <div class="reveal mt-9">
      <CtaButtons />
    </div>
  </section>

  <!-- Honest notes -->
  <section class="container-prose py-8 sm:py-10">
    <p class="reveal max-w-2xl border-t border-forest/15 pt-6 text-sm leading-relaxed text-soft">
      <span class="font-semibold text-forest">A few honest notes.</span> Plus is entirely
      optional — BeFree's core is free forever, and the crisis helpline is never gated.
      App &amp; content blocking is available on Android first (iOS is on the way), uses a
      private on-device filter, and asks only for the permissions each feature needs — all
      revocable any time. Payments are handled by Google Play; we never see your card
      details.
    </p>
  </section>

  <!-- Closing CTA -->
  <section class="reveal container-prose pb-14 pt-6 text-center sm:pb-20">
    <Sprout class="mx-auto mb-5 h-11 w-auto text-forest" />
    <h2 class="display-lg">Free to start, today<FullStop /></h2>
    <p class="lead mx-auto mt-5 max-w-md text-ink/80">
      Download BeFree and use it free. Upgrade to Plus from inside the app whenever it feels
      right.
    </p>
    <div class="mt-8">
      <CtaButtons align="center" />
    </div>
  </section>
</Base>
