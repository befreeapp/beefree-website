---
import Base from '../layouts/Base.astro';
import FullStop from '../components/FullStop.astro';
import CtaButtons from '../components/CtaButtons.astro';
import Sprout from '../components/Sprout.astro';
import BefreePlusLockup from '../components/BefreePlusLockup.astro';
import FilmPlayer from '../components/FilmPlayer.astro';
import Curve from '../components/Curve.astro';
import {
  PLUS_PRICES,
  PLUS_YEARLY_SAVING,
  PLUS_TRIAL_DAYS,
  PLUS_BENEFITS,
  FREE_FEATURES,
} from '../data/plus';
import { PLATFORM_FEATURES, IOS_LIVE } from '../data/platforms';

const monthly = PLUS_PRICES.monthly.replace('£', '');
const yearly = PLUS_PRICES.yearly.replace('£', '');
const plusSchema = {
  '@type': 'SoftwareApplication',
  name: 'Befree Plus',
  operatingSystem: 'Android',
  applicationCategory: 'HealthApplication',
  url: new URL('/plus', Astro.site!).href,
  description:
    'Befree Plus adds a full app blocker and content filter, a YouTube Shorts and Instagram Reels blocker, unlimited AI chat, and partner check-ins to the free Befree app. 14-day free trial.',
  publisher: { '@id': new URL('/#org', Astro.site!).href },
  offers: [
    {
      '@type': 'Offer',
      name: 'Monthly',
      price: monthly,
      priceCurrency: 'GBP',
      description: `${PLUS_TRIAL_DAYS}-day free trial for new subscribers`,
    },
    {
      '@type': 'Offer',
      name: 'Yearly',
      price: yearly,
      priceCurrency: 'GBP',
      description: `${PLUS_TRIAL_DAYS}-day free trial for new subscribers`,
    },
  ],
};
---

<Base
  title="Befree Plus — app, Shorts & Reels blocker, AI chat"
  description="Befree Plus adds a full app blocker, a YouTube Shorts & Instagram Reels blocker, unlimited AI chat and partner check-ins. 14 days free, then from £3.99/month."
  schema={plusSchema}
>
  <!-- Hero — the campaign's "Go further, if you want" card: forest, the
       statement, a bubble listing what Plus adds, the Plus film on a disc. -->
  <section class="paper relative overflow-hidden bg-forest text-cream">
    <span
      class="pointer-events-none absolute -right-20 top-[46%] h-[20rem] w-[20rem] rounded-full bg-terracotta sm:-right-24 sm:h-[28rem] sm:w-[28rem] lg:-right-36 lg:top-[16%] lg:h-[34rem] lg:w-[34rem]"
      aria-hidden="true"></span>
    <div
      class="container-prose relative pb-14 pt-8 sm:pt-12 lg:grid lg:grid-cols-[1.15fr_0.85fr] lg:items-center lg:gap-x-8 lg:pb-20 lg:pt-16"
    >
      <div>
        <p class="eyebrow eyebrow--onForest reveal">Optional BeFree Plus</p>
        <div class="reveal mt-4" style="--reveal-delay:60ms">
          <BefreePlusLockup size="h-9" tone="cream" />
        </div>
        <h1 class="display-xl reveal mt-5 max-w-[10ch] text-cream" style="--reveal-delay:120ms">
          Go further, if you want<FullStop />
        </h1>
        <p class="lead reveal mt-6 max-w-md text-mist/85" style="--reveal-delay:180ms">
          BeFree is free — and stays free. When you’re ready for deeper support, Plus
          unlocks a few extra tools —
          <span class="font-semibold text-cream">free for {PLUS_TRIAL_DAYS} days</span>, then
          from {PLUS_PRICES.monthly}/month.
        </p>
        <div class="bubble reveal mt-9 max-w-md" style="--reveal-delay:240ms">
          <ul class="space-y-1.5 text-lg text-forest">
            {PLUS_BENEFITS.map((b) => <li>{b.title}</li>)}
          </ul>
        </div>
      </div>
      <div class="reveal relative mt-14 lg:mt-0 lg:justify-self-end" style="--reveal-delay:200ms">
        <FilmPlayer
          size="large"
          tone="onForest"
          src="/assets/film-plus.mp4"
          poster="/assets/film-plus-poster.webp"
          label="BeFree Plus — a 33 second film"
          caption="33 seconds · with sound"
        />
      </div>
    </div>
  </section>

  <div class="bg-forest">
    <Curve fill="#FBF6EC" flip />
  </div>

  <!-- Free vs Plus — two flat colour blocks -->
  <section class="container-prose py-10 sm:py-14">
    <div class="grid gap-5 lg:grid-cols-2">
      <div class="reveal rounded-[2rem] bg-mist/70 p-7 sm:p-9">
        <div class="flex items-center gap-3">
          <Sprout class="h-8 w-auto text-teal" />
          <h2 class="text-2xl sm:text-3xl">Always free<FullStop /></h2>
        </div>
        <p class="mt-3 text-soft">The heart of BeFree, with no paywall and no ads.</p>
        <ul class="mt-6 space-y-3">
          {
            FREE_FEATURES.map((f) => (
              <li class="flex items-start gap-3 text-[0.95rem] text-ink/90">
                <span class="mt-2 h-1.5 w-1.5 flex-none rounded-full bg-terracotta" aria-hidden="true" />
                <span>{f}</span>
              </li>
            ))
          }
        </ul>
      </div>

      <div class="reveal paper rounded-[2rem] bg-forest p-7 text-cream sm:p-9" style="--reveal-delay:120ms">
        <div class="flex items-center justify-between gap-4">
          <h2 class="text-2xl text-cream sm:text-3xl">With Plus<FullStop /></h2>
          <span class="rounded-full bg-amber px-3 py-1 text-xs font-semibold text-forest">
            {PLUS_TRIAL_DAYS} days free
          </span>
        </div>
        <p class="mt-3 text-mist/80">Everything in free, plus:</p>
        <ul class="mt-6 space-y-5">
          {
            PLUS_BENEFITS.map((b, i) => (
              <li>
                <p class="eyebrow eyebrow--onForest">0{i + 1}</p>
                <p class="mt-1 font-semibold text-cream">{b.title}</p>
                <p class="mt-0.5 text-sm leading-relaxed text-mist/75">{b.body}</p>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  <!-- Android & iPhone — what works where. Driven by data/platforms.ts. -->
  <section id="platforms" class="container-prose scroll-mt-24 py-10 sm:py-14">
    <p class="eyebrow reveal">Android &amp; iPhone</p>
    <h2 class="display-lg reveal mt-4" style="--reveal-delay:60ms">What works where<FullStop /></h2>
    <p class="lead reveal mt-5 max-w-lg text-ink/80" style="--reveal-delay:120ms">
      {IOS_LIVE ? 'BeFree is on Android and iPhone.' : 'BeFree is on Android now, with iPhone on the way.'}
      Some tools rely on device features only Android offers, so here’s the honest picture.
    </p>
    <div class="reveal mt-8 overflow-x-auto" style="--reveal-delay:160ms">
      <table class="w-full min-w-[34rem] border-collapse text-left text-[0.95rem]">
        <thead>
          <tr class="border-b border-forest/20 text-xs font-semibold uppercase tracking-[0.14em] text-soft">
            <th scope="col" class="py-3 pr-4 font-semibold">Feature</th>
            <th scope="col" class="w-28 py-3 pr-4 font-semibold">Android</th>
            <th scope="col" class="w-64 py-3 font-semibold">
              iPhone{!IOS_LIVE && <span class="ml-1.5 normal-case tracking-normal text-soft/80">(coming soon)</span>}
            </th>
          </tr>
        </thead>
        <tbody>
          {
            PLATFORM_FEATURES.map((f) => (
              <tr class="border-b border-hairline align-top">
                <td class="py-3.5 pr-4">
                  <span class="text-ink/90">{f.name}</span>
                  <span class="ml-2 rounded-full bg-mist px-2 py-0.5 text-[0.65rem] font-semibold uppercase tracking-wide text-teal">
                    {f.tier}
                  </span>
                </td>
                {[f.android, f.ios].map((a) => (
                  <td class="py-3.5 pr-4">
                    {a.state === 'yes' && (
                      <span class="font-semibold text-teal">
                        <span aria-hidden="true">✓</span> Yes
                      </span>
                    )}
                    {a.state === 'coming' && (
                      <>
                        <span class="rounded-full bg-amber/90 px-2 py-0.5 text-xs font-semibold text-forest">Coming</span>
                        <span class="mt-1 block text-xs leading-relaxed text-soft">{a.note}</span>
                      </>
                    )}
                    {a.state === 'no' && (
                      <>
                        <span class="font-semibold text-soft">Not available</span>
                        <span class="mt-1 block text-xs leading-relaxed text-soft">{a.note}</span>
                      </>
                    )}
                  </td>
                ))}
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
    <p class="reveal mt-4 text-xs text-soft">
      We’ll only ever sell Plus features that work on your phone — the app shows the
      right set for your device.
    </p>
  </section>

  <!-- Pricing -->
  <section class="container-prose py-10 sm:py-14">
    <p class="eyebrow reveal">Pricing</p>
    <h2 class="display-lg reveal mt-4" style="--reveal-delay:60ms">Simple pricing<FullStop /></h2>
    <p class="lead reveal mt-5 max-w-md text-ink/80" style="--reveal-delay:120ms">
      Both plans start with a {PLUS_TRIAL_DAYS}-day free trial for new subscribers. Billed
      through Google Play; cancel any time from your store account — during the trial,
      you pay nothing.
    </p>
    <div class="mt-9 grid gap-5 sm:grid-cols-2">
      <div class="reveal rounded-[2rem] bg-mist/70 p-7 sm:p-9">
        <p class="eyebrow">Monthly</p>
        <p class="mt-3">
          <span class="font-display text-4xl text-forest">{PLUS_PRICES.monthly}</span>
          <span class="text-soft"> / month</span>
        </p>
        <p class="mt-3 text-sm text-soft">
          {PLUS_TRIAL_DAYS} days free, then {PLUS_PRICES.monthly}/month. Stop whenever you like.
        </p>
      </div>

      <div class="reveal paper relative rounded-[2rem] bg-forest p-7 text-cream sm:p-9" style="--reveal-delay:120ms">
        <span class="absolute right-6 top-6 rounded-full bg-amber px-3 py-1 text-xs font-semibold text-forest">
          Save {PLUS_YEARLY_SAVING}
        </span>
        <p class="eyebrow eyebrow--onForest">Yearly</p>
        <p class="mt-3">
          <span class="font-display text-4xl text-cream">{PLUS_PRICES.yearly}</span>
          <span class="text-mist/75"> / year</span>
        </p>
        <p class="mt-3 text-sm text-mist/75">
          {PLUS_TRIAL_DAYS} days free, then {PLUS_PRICES.yearly}/year. Best value for sticking with it.
        </p>
      </div>
    </div>

    <div class="reveal mt-9">
      <CtaButtons />
    </div>
  </section>

  <!-- Honest notes -->
  <section class="container-prose py-8 sm:py-10">
    <p class="reveal max-w-2xl border-t border-forest/15 pt-6 text-sm leading-relaxed text-soft">
      <span class="font-semibold text-forest">A few honest notes.</span> Plus is entirely
      optional — BeFree's core is free forever, and the crisis helpline is never gated.
      App &amp; content blocking and the short-form blocker are available on Android first
      (iOS is on the way). The short-form blocker is a separate, opt-in accessibility
      service that works entirely on your device: it recognises the Shorts or Reels feed
      by its on-screen layout, never reads what you're watching, and sends nothing
      anywhere. Every permission is asked for only when a feature needs it, and can be
      revoked any time. The {PLUS_TRIAL_DAYS}-day trial is for new subscribers; payments
      are handled by Google Play, and we never see your card details.
    </p>
  </section>

  <!-- Closing CTA -->
  <section class="reveal container-prose pb-14 pt-6 text-center sm:pb-20">
    <Sprout class="mx-auto mb-5 h-11 w-auto text-forest" />
    <h2 class="display-lg">Free to start, today<FullStop /></h2>
    <p class="lead mx-auto mt-5 max-w-md text-ink/80">
      Download BeFree and use it free. Upgrade to Plus from inside the app whenever it feels
      right.
    </p>
    <div class="mt-8">
      <CtaButtons align="center" />
    </div>
  </section>
</Base>
