---
import Base from '../layouts/Base.astro';
import FullStop from '../components/FullStop.astro';
import FeatureCard from '../components/FeatureCard.astro';
import CtaButtons from '../components/CtaButtons.astro';
import Sprout from '../components/Sprout.astro';
import Curve from '../components/Curve.astro';
import FilmPlayer from '../components/FilmPlayer.astro';
import ScreenshotCarousel from '../components/ScreenshotCarousel.astro';
import BefreePlusLockup from '../components/BefreePlusLockup.astro';
import { PLUS_PRICES, PLUS_YEARLY_SAVING, PLUS_BENEFITS, FREE_FEATURES } from '../data/plus';
import { PLAY_URL } from '../data/links';

const features = [
  {
    icon: '💬',
    title: 'Your AI accountability partner',
    body: 'A companion you name and talk to anytime — a gentle nudge when you go quiet, a kind word after a slip. Never a lecture.',
  },
  {
    icon: '🛡️',
    title: 'Block what pulls you in',
    body: 'A built-in app blocker for the apps that pull you in — block on a schedule or by place, plus an on-device adult-content filter and strict mode.',
    badge: 'Plus',
  },
  {
    icon: '🌱',
    iconType: 'sprout',
    title: 'Small wins, every day',
    body: 'A simple daily check-in builds your streak. Honest check-ins are the whole practice — no judgement either way.',
  },
  {
    icon: '💛',
    title: 'Help, one tap away',
    body: 'Supportive links to counselling, articles, and crisis lines — always available and close by when you need them.',
  },
];

const values = [
  { title: 'Free to use', body: 'The core app is free, with no ads. Plus is an optional extra.' },
  { title: 'Private by design', body: 'Your data stays on your device. Never sold.' },
  { title: 'A companion, not a warden', body: 'Support without shame, on your terms.' },
  { title: 'You stay in control', body: 'Every permission is optional and reversible.' },
];

const appSchema = {
  '@type': 'MobileApplication',
  name: 'Befree',
  operatingSystem: 'Android',
  applicationCategory: 'HealthApplication',
  url: Astro.site!.href,
  description:
    'Befree is a free app for phone addiction — an AI accountability partner, an app blocker and content filter, and daily check-ins to help you spend less time on your phone.',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'GBP' },
  downloadUrl: PLAY_URL,
  installUrl: PLAY_URL,
  publisher: { '@id': new URL('/#org', Astro.site!).href },
};
---

<Base
  title="Befree — ease phone addiction: AI partner & app blocker"
  description="Ease phone addiction the kind way — an AI accountability partner, an app blocker, and daily check-ins. Free, private, no ads."
  schema={appSchema}
>
  <!-- ================= HERO ================= -->
  <section class="paper relative overflow-hidden">
    <div class="container-prose relative pb-10 pt-4 sm:pt-8 lg:pb-16 lg:pt-10">
      <!-- Grid placement rather than DOM order, so the film sits between the
           headline and the store buttons on mobile, but beside them on desktop —
           without duplicating the buttons. -->
      <div class="grid gap-y-8 lg:grid-cols-[1.05fr_0.95fr] lg:items-start lg:gap-x-14">
        <div class="reveal max-w-xl lg:col-start-1 lg:row-start-1" style="--reveal-delay:80ms">
          <h1 class="text-5xl leading-[1.02] sm:text-6xl lg:text-7xl">
            Take back your time<FullStop />
          </h1>
          <p class="mt-5 text-lg leading-relaxed text-soft sm:mt-6 sm:text-xl">
            A kinder way to ease phone addiction — an AI accountability partner, an
            app blocker, and support when you need it. Free, private, no ads.
          </p>
        </div>

        <!-- The explainer film, with a terracotta accent behind it -->
        <div
          class="reveal relative lg:col-start-2 lg:row-start-1 lg:row-span-2 lg:self-center"
          style="--reveal-delay:200ms"
        >
          <span
            class="pointer-events-none absolute -left-4 bottom-8 h-28 w-28 rounded-full bg-terracotta/90 sm:h-36 sm:w-36 lg:-left-8"
            aria-hidden="true"></span>
          <FilmPlayer
            class="relative"
            src="/assets/film-overview.mp4"
            poster="/assets/film-overview-poster.webp"
            label="So, what does BeFree do? — a 33 second film"
            caption="33 seconds · with sound"
          />
        </div>

        <div
          class="reveal lg:col-start-1 lg:row-start-2 lg:mt-8"
          style="--reveal-delay:260ms"
        >
          <CtaButtons />
        </div>
      </div>
    </div>
  </section>

  <Curve fill="#0F3D39" />

  <!-- ============ MAKE ROOM FOR REAL LIFE ============ -->
  <section class="paper bg-forest text-cream">
    <div class="container-prose py-9 sm:py-16">
      <p class="eyebrow eyebrow--onForest reveal">A kinder way</p>
      <h2 class="reveal mt-3 max-w-2xl text-[2rem] text-cream sm:text-5xl" style="--reveal-delay:60ms">
        Make room for real life<FullStop />
      </h2>
      <p class="reveal mt-5 max-w-xl text-lg leading-relaxed text-mist/80" style="--reveal-delay:120ms">
        An unhurried cup of tea. A chapter of that book. A conversation without checking
        your screen. You don’t have to give up your phone to want a little more space
        from it.
      </p>
      <img
        src="/assets/photo/be-here.webp"
        alt="Two people sharing a pot of tea and biscuits at a sunlit garden table."
        width="954"
        height="380"
        loading="lazy"
        decoding="async"
        class="photo-curve--wide reveal mt-8 h-auto sm:mt-10 w-full object-cover"
        style="--reveal-delay:160ms"
      />
    </div>
  </section>

  <div class="bg-forest">
    <Curve fill="#FBF6EC" flip />
  </div>

  <!-- ================= WHAT IT IS ================= -->
  <section class="container-prose py-9 sm:py-16">
    <p class="eyebrow reveal">Inside BeFree</p>
    <h2 class="reveal mt-3 text-[2rem] sm:text-5xl" style="--reveal-delay:60ms">
      What it is<FullStop />
    </h2>
    <p class="reveal mt-4 max-w-xl text-soft" style="--reveal-delay:120ms">
      Gentle, practical help for phone addiction — four calm ways to spend less time
      pulled into your screen. A little support as you work on your phone habits; no
      promise of a perfect streak.
    </p>
    <div class="mt-7 grid sm:mt-9 grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-4">
      {
        features.map((f, i) => (
          <FeatureCard
            icon={f.icon}
            iconType={f.iconType}
            title={f.title}
            body={f.body}
            badge={f.badge}
            index={i}
          />
        ))
      }
    </div>
  </section>

  <div class="reveal">
    <ScreenshotCarousel />
  </div>

  <Curve fill="#0F3D39" />

  <!-- ============ ONE SLIP ISN'T THE WHOLE STORY ============ -->
  <section class="paper relative overflow-hidden bg-forest text-cream">
    <span
      class="pointer-events-none absolute -right-20 -top-16 h-56 w-56 rounded-full bg-terracotta/90 sm:h-72 sm:w-72"
      aria-hidden="true"></span>
    <div class="container-prose relative py-10 sm:py-20">
      <div class="max-w-2xl">
        <p class="eyebrow eyebrow--onForest reveal">A kinder perspective</p>
        <h2 class="reveal mt-3 text-[2rem] leading-[1.05] text-cream sm:text-5xl" style="--reveal-delay:60ms">
          One slip isn’t the whole story<FullStop />
        </h2>
        <p class="reveal mt-5 text-lg leading-relaxed text-mist/85" style="--reveal-delay:120ms">
          Pause. Take a breath. Begin again when you’re ready. A streak is a record —
          not a verdict.
        </p>
      </div>

      <div
        class="reveal mt-9 grid sm:mt-12 grid-cols-1 gap-x-8 gap-y-7 sm:grid-cols-2 lg:grid-cols-4"
        style="--reveal-delay:160ms"
      >
        {
          values.map((v) => (
            <div class="border-l-2 border-terracotta pl-4">
              <h3 class="text-cream">{v.title}</h3>
              <p class="mt-1 text-sm leading-relaxed text-mist/80">{v.body}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <div class="bg-forest">
    <Curve fill="#FBF6EC" flip />
  </div>

  <!-- ================= FREE & PLUS ================= -->
  <section class="container-prose py-9 sm:py-16">
    <p class="eyebrow reveal">Free &amp; Plus</p>
    <h2 class="reveal mt-3 text-[2rem] sm:text-5xl" style="--reveal-delay:60ms">
      Pick what supports you<FullStop />
    </h2>

    <div class="mt-7 grid sm:mt-9 gap-6 lg:grid-cols-[1fr_1fr] lg:items-start">
      <!-- Free -->
      <div class="reveal rounded-[1.75rem] border border-hairline bg-white/70 p-6 shadow-card sm:p-7">
        <div class="flex items-center gap-2">
          <Sprout class="h-7 w-auto text-teal" />
          <h3 class="text-2xl">Start free<FullStop /></h3>
        </div>
        <p class="mt-2 text-sm text-soft">The core app, with no paywall and no ads.</p>
        <ul class="mt-5 space-y-3">
          {
            FREE_FEATURES.map((f) => (
              <li class="flex items-start gap-2 text-[0.95rem] text-ink/90">
                <span class="mt-0.5 text-teal" aria-hidden="true">✓</span>
                <span>{f}</span>
              </li>
            ))
          }
        </ul>
      </div>

      <!-- Plus -->
      <div
        class="reveal rounded-[1.75rem] border-2 border-teal bg-mist/40 p-6 shadow-soft sm:p-7"
        style="--reveal-delay:120ms"
      >
        <BefreePlusLockup size="h-8" />
        <h3 class="mt-4 text-2xl">Go further, if you want<FullStop /></h3>
        <p class="mt-2 text-sm text-soft">
          Everything in free, plus — from
          <span class="font-semibold text-forest">{PLUS_PRICES.monthly}/month</span>
          (or {PLUS_PRICES.yearly}/year, saving {PLUS_YEARLY_SAVING}).
        </p>
        <ul class="mt-5 space-y-4">
          {
            PLUS_BENEFITS.map((b) => (
              <li class="flex items-start gap-3">
                <span class="text-2xl" aria-hidden="true">{b.icon}</span>
                <span>
                  <span class="block font-semibold text-forest">{b.title}</span>
                  <span class="mt-0.5 block text-sm leading-relaxed text-soft">{b.body}</span>
                </span>
              </li>
            ))
          }
        </ul>
        <div class="mt-6 flex flex-wrap items-center gap-3">
          <a
            href="/plus"
            class="inline-flex items-center gap-2 rounded-2xl bg-forest px-5 py-3 font-semibold text-cream shadow-soft transition-transform hover:-translate-y-0.5"
          >
            See what’s in Plus
            <span aria-hidden="true">→</span>
          </a>
          <span class="text-xs text-soft">Optional. Cancel any time.</span>
        </div>
      </div>
    </div>
  </section>

  <!-- ================= CLOSING ================= -->
  <section class="paper relative overflow-hidden">
    <div class="container-prose py-10 sm:py-20">
      <div class="lg:grid lg:grid-cols-[0.95fr_1.05fr] lg:items-center lg:gap-14">
        <div class="reveal order-2 lg:order-1">
          <Sprout class="mb-5 h-14 w-auto text-forest" />
          <h2 class="text-[2rem] leading-[1.05] sm:text-5xl">Your next chapter<FullStop /></h2>
          <p class="mt-5 max-w-md text-lg leading-relaxed text-soft">
            A little less scrolling. A little more of what you love. Start with one
            honest check-in — today.
          </p>
          <div class="mt-8">
            <CtaButtons />
          </div>
          <p class="mt-10 max-w-lg text-xs leading-relaxed text-soft">
            BeFree is a support tool, not medical treatment. If you’re struggling, please
            reach out to a professional or a
            <a href="/support#crisis" class="underline underline-offset-2 hover:text-forest"
              >crisis line</a
            >.
          </p>
        </div>
        <div class="reveal order-1 mb-9 lg:order-2 lg:mb-0" style="--reveal-delay:120ms">
          <img
            src="/assets/photo/next-chapter.webp"
            alt="An open book resting on a sunlit park bench, surrounded by green leaves."
            width="394"
            height="660"
            loading="lazy"
            decoding="async"
            class="photo-curve--alt mx-auto h-60 w-full max-w-[22rem] object-cover sm:h-auto lg:max-w-none"
          />
        </div>
      </div>
    </div>
  </section>
</Base>
