---
import Base from '../layouts/Base.astro';
import FullStop from '../components/FullStop.astro';
import CtaButtons from '../components/CtaButtons.astro';
import Sprout from '../components/Sprout.astro';
import Curve from '../components/Curve.astro';
import FilmPlayer from '../components/FilmPlayer.astro';
import Photo from '../components/Photo.astro';
import PhoneFrame from '../components/PhoneFrame.astro';
import BefreePlusLockup from '../components/BefreePlusLockup.astro';
import {
  PLUS_PRICES,
  PLUS_YEARLY_SAVING,
  PLUS_TRIAL_DAYS,
  PLUS_BENEFITS,
  FREE_FEATURES,
} from '../data/plus';
import { PLAY_URL } from '../data/links';

const features = [
  {
    title: 'Your AI accountability partner',
    body: 'A companion you name and talk to anytime — a gentle nudge when you go quiet, a kind word after a slip. Never a lecture.',
  },
  {
    title: 'Block what pulls you in',
    body: 'An app blocker for the apps that pull you in — on a schedule or by place — plus a Shorts & Reels blocker and an on-device adult-content filter.',
    badge: 'Plus',
  },
  {
    title: 'Small wins, every day',
    body: 'A simple daily check-in builds your streak, and you can see your screen time app by app. Honest check-ins are the whole practice — no judgement either way.',
  },
  {
    title: 'Help, one tap away',
    body: 'Supportive links to counselling, articles, and crisis lines — always close by when you need them.',
  },
];

const values = [
  { title: 'Free to use', body: 'The core app is free, with no ads. Plus is an optional extra.' },
  { title: 'Private by design', body: 'Your data stays on your device. Never sold.' },
  { title: 'A companion, not a warden', body: 'Support without shame, on your terms.' },
  { title: 'You stay in control', body: 'Every permission is optional and reversible.' },
];

// The Play Store screens, for the "closer look" strip and the lightbox.
const shots = [
  { src: '/assets/shot-01-check-in.webp', alt: 'The BeFree home screen, with the daily check-in and your streak.' },
  { src: '/assets/shot-02-companion.webp', alt: 'A warm conversation with the AI companion, Atlas.' },
  { src: '/assets/shot-03-blocking.webp', alt: 'App and content blocking — schedules, places and an adult-content filter.' },
  { src: '/assets/shot-04-support.webp', alt: 'The support library: counselling directories, articles and crisis lines.' },
  { src: '/assets/shot-05-plus.webp', alt: 'The optional BeFree Plus screen, with its features and pricing.' },
];

const appSchema = {
  '@type': 'MobileApplication',
  name: 'Befree',
  operatingSystem: 'Android',
  applicationCategory: 'HealthApplication',
  url: Astro.site!.href,
  description:
    'Befree is a free app for phone addiction — an AI accountability partner, an app blocker, a YouTube Shorts and Instagram Reels blocker, a content filter, screen-time insights and daily check-ins to help you spend less time on your phone.',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'GBP' },
  downloadUrl: PLAY_URL,
  installUrl: PLAY_URL,
  publisher: { '@id': new URL('/#org', Astro.site!).href },
};
---

<Base
  title="Befree — ease phone addiction: AI partner & app blocker"
  description="Ease phone addiction the kind way — an AI accountability partner, an app & Shorts blocker, and daily check-ins. Free, private, no ads."
  schema={appSchema}
>
  <!-- ================= HERO ================= -->
  <!-- Composed like the campaign cards: a big statement on the left, the film
       as the main object on the right, a terracotta disc behind it that runs
       off the edge, and the forest sweep rising through the bottom. -->
  <section class="paper relative overflow-hidden">
    <span
      class="pointer-events-none absolute -right-20 top-[44%] h-[20rem] w-[20rem] rounded-full bg-terracotta sm:-right-24 sm:h-[28rem] sm:w-[28rem] lg:-right-36 lg:top-[14%] lg:h-[36rem] lg:w-[36rem]"
      aria-hidden="true"></span>

    <div class="container-prose relative z-10 pb-16 pt-4 sm:pb-20 sm:pt-8 lg:pb-16 lg:pt-14">
      <!-- Grid placement rather than DOM order, so the film sits between the
           headline and the store buttons on mobile, but beside them on desktop. -->
      <div
        class="grid gap-y-8 lg:grid-cols-[1.15fr_0.85fr] lg:grid-rows-[auto_1fr] lg:items-start lg:gap-x-8"
      >
        <div class="reveal lg:col-start-1 lg:row-start-1" style="--reveal-delay:80ms">
          <h1 class="display-xl max-w-[9ch]">Take back your time<FullStop /></h1>
          <p class="lead mt-6 max-w-md text-ink/80">
            A kinder way to ease phone addiction — an AI accountability partner, an
            app blocker, and support close by when you need it.
          </p>
        </div>

        <div
          class="reveal relative lg:col-start-2 lg:row-start-1 lg:row-span-2 lg:justify-self-end"
          style="--reveal-delay:200ms"
        >
          <FilmPlayer
            size="large"
            src="/assets/film-overview.mp4"
            poster="/assets/film-overview-poster.webp"
            label="So, what does BeFree do? — a 33 second film"
            caption="33 seconds · with sound"
          />
        </div>

        <div class="reveal lg:col-start-1 lg:row-start-2 lg:mt-8" style="--reveal-delay:260ms">
          <CtaButtons />
        </div>
      </div>
    </div>

    <Curve depth="hero" fill="#0F3D39" class="absolute inset-x-0 bottom-0 z-[1]" />
  </section>

  <!-- ============ 01 · MAKE ROOM FOR REAL LIFE ============ -->
  <!-- Copy on the left; the photograph takes the right half and runs off the
       edge of the screen, inside one big curve, with a disc tucked behind it. -->
  <section class="paper relative overflow-hidden bg-forest text-cream">
    <div class="container-prose relative py-12 sm:py-16 lg:py-28">
      <div class="lg:max-w-[44%]">
        <p class="eyebrow eyebrow--onForest reveal">01 / A kinder way</p>
        <h2 class="display-lg reveal mt-4 text-cream" style="--reveal-delay:60ms">
          Make room for real life<FullStop />
        </h2>
        <p class="lead reveal mt-6 max-w-sm text-mist/85" style="--reveal-delay:120ms">
          An unhurried cup of tea. A chapter of that book. You don’t have to give up
          your phone to want a little more space from it.
        </p>
      </div>
    </div>

    <div
      class="reveal relative ml-6 h-64 sm:ml-12 sm:h-80 lg:absolute lg:inset-y-0 lg:right-0 lg:ml-0 lg:h-auto lg:w-[47%]"
      style="--reveal-delay:160ms"
    >
      <span
        class="pointer-events-none absolute -left-10 bottom-10 h-36 w-36 rounded-full bg-terracotta lg:-left-16 lg:bottom-16 lg:h-52 lg:w-52"
        aria-hidden="true"></span>
      <Photo
        src="/assets/photo/be-here-tall.webp"
        alt="Two people sharing a pot of tea at a sunlit garden table."
        width={694}
        height={690}
        shape="bleed"
        class="relative z-[1] h-full w-full"
      />
    </div>
  </section>

  <!-- ================= WHAT IT IS ================= -->
  <section class="container-prose py-12 sm:py-16 lg:py-20">
    <p class="eyebrow reveal">Inside BeFree</p>
    <h2 class="display-lg reveal mt-4" style="--reveal-delay:60ms">
      What it is<FullStop />
    </h2>
    <p class="lead reveal mt-5 max-w-md text-ink/80" style="--reveal-delay:120ms">
      Four calm ways to spend less time pulled into your screen — no promise of a
      perfect streak.
    </p>
    <!-- Editorial columns rather than boxed cards. -->
    <ul class="mt-10 grid grid-cols-1 gap-x-8 gap-y-8 sm:grid-cols-2 lg:mt-12 lg:grid-cols-4">
      {
        features.map((f, i) => (
          <li class="reveal border-t border-forest/15 pt-5" style={`--reveal-delay:${i * 90}ms`}>
            <div class="flex items-center justify-between">
              <p class="eyebrow">0{i + 1}</p>
              {f.badge && (
                <span class="rounded-full bg-mist px-2.5 py-0.5 text-xs font-semibold text-teal">
                  {f.badge}
                </span>
              )}
            </div>
            <h3 class="mt-4 text-xl leading-snug">{f.title}</h3>
            <p class="mt-2 text-[0.95rem] leading-relaxed text-soft">{f.body}</p>
          </li>
        ))
      }
    </ul>
  </section>

  <!-- ============ 02 · MEET YOUR COMPANION ============ -->
  <!-- The app screen as the object: phone on a disc that runs off the left
       edge, copy on the right. -->
  <section class="paper relative overflow-hidden bg-mist/60">
    <div
      class="container-prose relative py-12 sm:py-16 lg:grid lg:grid-cols-[0.9fr_1.1fr] lg:items-center lg:gap-x-12 lg:py-24"
    >
      <div class="reveal isolate relative mx-auto w-full max-w-[13.5rem] sm:max-w-[16.5rem] lg:mx-0 lg:justify-self-start">
        <!-- Disc pinned to the phone, so it never drifts under the copy. -->
        <span
          class="pointer-events-none absolute -left-28 bottom-6 -z-10 h-64 w-64 rounded-full bg-terracotta sm:-left-40 sm:h-80 sm:w-80 lg:-left-60 lg:-bottom-10 lg:h-[30rem] lg:w-[30rem]"
          aria-hidden="true"></span>
        <PhoneFrame
          src="/assets/screen-companion.webp"
          alt="A conversation with Atlas, the AI companion, in BeFree."
          width={614}
          height={1193}
        />
      </div>
      <div class="reveal mt-10 lg:mt-0" style="--reveal-delay:120ms">
        <p class="eyebrow">02 / AI companion</p>
        <h2 class="display-lg mt-4 max-w-[11ch]">Meet your companion<FullStop /></h2>
        <p class="lead mt-6 max-w-sm text-ink/80">
          Name it. Talk things through. A gentle nudge when you go quiet, a kind word
          after a slip — never a lecture.
        </p>
        <p class="mt-5 text-sm text-soft">AI support — not therapy or a crisis service.</p>
      </div>
    </div>
  </section>

  <!-- ============ 03 · MAKE SPACE, ON YOUR TERMS ============ -->
  <section class="paper relative overflow-hidden bg-forest text-cream">
    <div
      class="container-prose relative py-12 sm:py-16 lg:grid lg:grid-cols-[1.1fr_0.9fr] lg:items-center lg:gap-x-12 lg:py-24"
    >
      <div class="reveal">
        <p class="eyebrow eyebrow--onForest">03 / App blocking · Plus</p>
        <h2 class="display-lg mt-4 max-w-[11ch] text-cream">Make space. On your terms<FullStop /></h2>
        <p class="lead mt-6 max-w-sm text-mist/85">
          Block the apps that pull you in — on a schedule, or only in certain places.
          Step gently out of YouTube Shorts and Instagram Reels. Filter adult content on
          your device. Every permission is yours to grant, and to take back.
        </p>
        <a
          href="/plus"
          class="mt-7 inline-flex items-center gap-2 rounded-full bg-cream px-5 py-2.5 text-[0.95rem] font-semibold text-forest transition-transform hover:-translate-y-0.5"
        >
          What’s in Plus
          <span aria-hidden="true">→</span>
        </a>
      </div>
      <div
        class="reveal isolate relative mx-auto mt-10 w-full max-w-[13.5rem] sm:max-w-[16.5rem] lg:mx-0 lg:mt-0 lg:justify-self-end"
        style="--reveal-delay:120ms"
      >
        <span
          class="pointer-events-none absolute -right-28 top-6 -z-10 h-64 w-64 rounded-full bg-terracotta sm:-right-40 sm:h-80 sm:w-80 lg:-right-60 lg:-top-10 lg:h-[32rem] lg:w-[32rem]"
          aria-hidden="true"></span>
        <PhoneFrame
          src="/assets/screen-blocking.webp"
          alt="The app blocking screen in BeFree: setup, places, rules and the adult-content filter."
          width={614}
          height={1193}
        />
      </div>
    </div>
  </section>

  <!-- A closer look: every store screen, tap to expand -->
  <section class="container-prose py-10 sm:py-12" aria-label="A closer look inside BeFree">
    <div class="reveal flex items-baseline justify-between gap-4">
      <p class="eyebrow">A closer look</p>
      <p class="text-xs text-soft">Tap a screen to expand it</p>
    </div>
    <!-- A swipeable strip on phones, a five-up row from tablet. -->
    <ul
      class="shots reveal -mx-5 mt-5 flex gap-3 overflow-x-auto px-5 sm:mx-0 sm:grid sm:grid-cols-5 sm:gap-4 sm:overflow-visible sm:px-0"
      style="--reveal-delay:80ms"
    >
      {
        shots.map((s, i) => (
          <li class="w-[40%] flex-none snap-center sm:w-auto">
            <button
              type="button"
              class="block w-full cursor-zoom-in overflow-hidden rounded-xl transition-transform hover:-translate-y-1 focus-visible:-translate-y-1 sm:rounded-2xl"
              data-shot
              data-gallery="app"
              data-index={i}
              data-src={s.src}
              data-alt={s.alt}
              aria-label={`Expand: ${s.alt}`}
            >
              <img
                src={s.src}
                alt=""
                width="880"
                height="1564"
                loading="lazy"
                decoding="async"
                class="h-auto w-full"
              />
            </button>
          </li>
        ))
      }
    </ul>
  </section>
  <style>
    @media (max-width: 639px) {
      .shots {
        scroll-snap-type: x proximity;
        scrollbar-width: none;
      }
      .shots::-webkit-scrollbar {
        display: none;
      }
    }
  </style>

  <!-- ============ 04 · ONE SLIP ISN'T THE WHOLE STORY ============ -->
  <!-- The campaign's speech-bubble card: the statement inside a big cream
       bubble on forest, a disc behind its lower-right corner. -->
  <section class="paper relative overflow-hidden bg-forest text-cream">
    <div class="container-prose relative py-12 sm:py-16 lg:py-24">
      <div class="relative">
        <span
          class="pointer-events-none absolute -bottom-12 -right-20 h-48 w-48 rounded-full bg-terracotta lg:-bottom-6 lg:left-[34rem] lg:right-auto lg:h-[22rem] lg:w-[22rem]"
          aria-hidden="true"></span>
        <div class="bubble bubble--xl reveal relative max-w-3xl" style="--reveal-delay:60ms">
          <p class="eyebrow">04 / A kinder perspective</p>
          <h2 class="display-lg mt-4 max-w-[12ch]">One slip isn’t the whole story<FullStop /></h2>
          <p class="lead mt-5 max-w-sm text-ink/80">
            Pause. Take a breath. Begin again when you’re ready. A streak is a record —
            not a verdict.
          </p>
        </div>
      </div>

      <ul
        class="reveal mt-14 grid grid-cols-1 gap-x-8 gap-y-6 sm:grid-cols-2 lg:mt-16 lg:grid-cols-4"
        style="--reveal-delay:160ms"
      >
        {
          values.map((v) => (
            <li>
              <h3 class="text-lg text-cream">
                {v.title}<FullStop />
              </h3>
              <p class="mt-1 text-sm leading-relaxed text-mist/75">{v.body}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- ================= FREE & PLUS ================= -->
  <!-- Two flat colour blocks, no outlines. -->
  <section class="container-prose py-12 sm:py-16 lg:py-20">
    <p class="eyebrow reveal">Free &amp; Plus</p>
    <h2 class="display-lg reveal mt-4" style="--reveal-delay:60ms">
      Pick what supports you<FullStop />
    </h2>

    <div class="mt-9 grid gap-5 lg:mt-12 lg:grid-cols-2">
      <!-- Free -->
      <div class="reveal rounded-[2rem] bg-mist/70 p-7 sm:p-9">
        <div class="flex items-center gap-3">
          <Sprout class="h-8 w-auto text-teal" />
          <h3 class="text-2xl sm:text-3xl">Start free<FullStop /></h3>
        </div>
        <p class="mt-3 text-soft">The core app, with no paywall and no ads.</p>
        <ul class="mt-6 space-y-3">
          {
            FREE_FEATURES.map((f) => (
              <li class="flex items-start gap-3 text-[0.95rem] text-ink/90">
                <span class="mt-2 h-1.5 w-1.5 flex-none rounded-full bg-terracotta" aria-hidden="true" />
                <span>{f}</span>
              </li>
            ))
          }
        </ul>
      </div>

      <!-- Plus -->
      <div class="reveal paper rounded-[2rem] bg-forest p-7 text-cream sm:p-9" style="--reveal-delay:120ms">
        <BefreePlusLockup size="h-8" tone="cream" />
        <h3 class="mt-5 text-2xl text-cream sm:text-3xl">Go further, if you want<FullStop /></h3>
        <p class="mt-3 text-mist/80">
          Everything in free, plus — <span class="font-semibold text-cream">free for {PLUS_TRIAL_DAYS} days</span>,
          then from {PLUS_PRICES.monthly}/month (or {PLUS_PRICES.yearly}/year, saving
          {PLUS_YEARLY_SAVING}).
        </p>
        <ul class="mt-6 space-y-5">
          {
            PLUS_BENEFITS.map((b, i) => (
              <li>
                <p class="eyebrow eyebrow--onForest">0{i + 1}</p>
                <p class="mt-1 font-semibold text-cream">{b.title}</p>
                <p class="mt-0.5 text-sm leading-relaxed text-mist/75">{b.body}</p>
              </li>
            ))
          }
        </ul>
        <div class="mt-7 flex flex-wrap items-center gap-4">
          <a
            href="/plus"
            class="inline-flex items-center gap-2 rounded-full bg-cream px-5 py-2.5 text-[0.95rem] font-semibold text-forest transition-transform hover:-translate-y-0.5"
          >
            See what’s in Plus
            <span aria-hidden="true">→</span>
          </a>
          <span class="text-xs text-mist/70">Optional. Cancel any time, including during the trial.</span>
        </div>
      </div>
    </div>
  </section>

  <!-- ================= CLOSING ================= -->
  <!-- The "Your next chapter" card: copy left, the bench photograph running
       off the right edge. -->
  <section class="paper relative overflow-hidden">
    <div class="container-prose relative py-12 sm:py-16 lg:py-28">
      <div class="reveal lg:max-w-[46%]">
        <Sprout class="mb-5 h-11 w-auto text-forest" />
        <h2 class="display-lg">Your next chapter<FullStop /></h2>
        <p class="lead mt-6 max-w-sm text-ink/80">
          A little less scrolling. A little more of what you love. Start with one honest
          check-in — today.
        </p>
        <div class="mt-8">
          <CtaButtons />
        </div>
        <p class="mt-10 max-w-md text-xs leading-relaxed text-soft">
          BeFree is a support tool, not medical treatment. If you’re struggling, please
          reach out to a professional or a
          <a href="/support#crisis" class="underline underline-offset-2 hover:text-forest"
            >crisis line</a
          >.
        </p>
      </div>
    </div>
    <div
      class="reveal relative ml-6 h-64 sm:ml-12 sm:h-80 lg:absolute lg:inset-y-0 lg:right-0 lg:ml-0 lg:h-auto lg:w-[46%]"
      style="--reveal-delay:120ms"
    >
      <span
        class="pointer-events-none absolute -left-10 bottom-10 h-36 w-36 rounded-full bg-terracotta lg:-left-16 lg:bottom-20 lg:h-56 lg:w-56"
        aria-hidden="true"></span>
      <Photo
        src="/assets/photo/next-chapter.webp"
        alt="A cup of tea and a closed notebook on a sunlit windowsill, beside a plant."
        width={820}
        height={675}
        shape="bleed"
        class="relative z-[1] h-full w-full"
      />
    </div>
  </section>
</Base>
