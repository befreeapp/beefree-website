---
// The BeFree sprout mark — two leaves and a stem under a terracotta "sun" dot,
// matching the app icon. Leaves/stem use `currentColor` so it recolours to its
// context (forest on cream, cream on forest); the dot defaults to terracotta.
interface Props {
  class?: string;
  dotColor?: string;
  title?: string;
}
const { class: className = '', dotColor = '#D85E36', title } = Astro.props;
const labelled = Boolean(title);
---
<svg
  class={className}
  viewBox="0 0 100 124"
  fill="none"
  xmlns="http://www.w3.org/2000/svg"
  role={labelled ? 'img' : undefined}
  aria-hidden={labelled ? undefined : 'true'}
  aria-label={title}
  focusable="false"
>
  {labelled && <title>{title}</title>}
  <!-- sun dot -->
  <circle cx="50" cy="18" r="15" fill={dotColor} />
  <!-- left leaf -->
  <path
    d="M50 84 C 30 84 12 70 12 46 C 34 50 49 62 50 84 Z"
    fill="currentColor"
  />
  <!-- right leaf -->
  <path
    d="M50 84 C 70 84 88 70 88 46 C 66 50 51 62 50 84 Z"
    fill="currentColor"
  />
  <!-- stem -->
  <path
    d="M50 78 C 50 96 50 104 50 112"
    stroke="currentColor"
    stroke-width="13"
    stroke-linecap="round"
  />
</svg>
