---
// The month-one campaign artwork, shown as the social posts they are.
// Tapping a card opens it full size in the shared lightbox.
const posts = [
  { src: '/assets/campaign/01-room-for-real-life.webp', alt: 'Campaign artwork: “Make room for real life.” An open book and a terracotta mug in warm daylight.' },
  { src: '/assets/campaign/05-your-next-chapter.webp', alt: 'Campaign artwork: “Your next chapter.” An open book on a sunlit park bench.' },
  { src: '/assets/campaign/08-be-here.webp', alt: 'Campaign artwork: “Be here. With them.” Two people sharing a pot of tea in a garden.' },
  { src: '/assets/campaign/03-begin-again.webp', alt: 'Campaign artwork: “One slip isn’t the whole story. Pause. Take a breath. Begin again when you’re ready.”' },
  { src: '/assets/campaign/02-carousel-01-check-in.webp', alt: 'Campaign artwork: “Start with one check-in.” The BeFree home screen.' },
  { src: '/assets/campaign/02-carousel-02-companion.webp', alt: 'Campaign artwork: “A little support. In your corner.” A chat with the AI companion.' },
  { src: '/assets/campaign/02-carousel-03-boundaries.webp', alt: 'Campaign artwork: “Your time. Your boundaries.” The app blocking screen.' },
  { src: '/assets/campaign/06-meet-your-companion.webp', alt: 'Campaign artwork: “Meet your AI companion. Name it. Talk things through.”' },
  { src: '/assets/campaign/07-check-in-01.webp', alt: 'Campaign artwork: “An honest moment.” Noticing how today is going.' },
  { src: '/assets/campaign/07-check-in-02.webp', alt: 'Campaign artwork: “A streak is a record. Not a verdict.” A sprout on rolling hills.' },
  { src: '/assets/campaign/07-check-in-03.webp', alt: 'Campaign artwork: “Begin again. No lecture.” A sunlit windowsill with a cup and notebook.' },
  { src: '/assets/campaign/10-support-close-by.webp', alt: 'Campaign artwork: “Useful support. Close by.” The support library of resources.' },
  { src: '/assets/campaign/04-support-without-ads.webp', alt: 'Campaign artwork: “Support. Without the ads.” Free at its core, no selling your data.' },
  { src: '/assets/campaign/09-free-plus-01.webp', alt: 'Campaign artwork: “Start free.” An AI companion, daily check-ins and a support library.' },
  { src: '/assets/campaign/09-free-plus-02.webp', alt: 'Campaign artwork: “Go further, if you want.” Optional BeFree Plus features.' },
  { src: '/assets/campaign/09-free-plus-03.webp', alt: 'Campaign artwork: “Pick what supports you.” The core is free, Plus is optional.' },
];
---
<ul class="grid grid-cols-2 gap-3 sm:grid-cols-3 sm:gap-4 lg:grid-cols-4">
  {
    posts.map((p, i) => (
      <li class="reveal" style={`--reveal-delay:${(i % 4) * 60}ms`}>
        <button
          type="button"
          class="block w-full cursor-zoom-in overflow-hidden rounded-2xl border border-hairline shadow-card transition-transform hover:-translate-y-1 focus-visible:-translate-y-1"
          data-shot
          data-gallery="campaign"
          data-index={i}
          data-src={p.src}
          data-alt={p.alt}
          aria-label={`Expand: ${p.alt}`}
        >
          <img
            src={p.src}
            alt={p.alt}
            width="1000"
            height="1000"
            loading="lazy"
            decoding="async"
            class="block aspect-square h-auto w-full object-cover"
          />
        </button>
      </li>
    ))
  }
</ul>
