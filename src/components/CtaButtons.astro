---
// Primary install CTAs. Neither store listing is live yet, so the badges link to a
// placeholder anchor and each carries an honest "coming soon" note beneath it.
interface Props {
  align?: 'start' | 'center';
}
const { align = 'start' } = Astro.props;
const rowAlign = align === 'center' ? 'justify-center' : 'justify-start';
const colAlign = align === 'center' ? 'items-center text-center' : 'items-start';

const stores = [
  { icon: 'play', label: 'Get it on', name: 'Google Play', note: 'Coming soon to Android' },
  { icon: 'apple', label: 'Download on the', name: 'App Store', note: 'Coming soon to iOS' },
];
---
<div class={`flex flex-wrap gap-x-4 gap-y-4 ${rowAlign}`}>
  {
    stores.map((s) => (
      <div class={`flex flex-col gap-1.5 ${colAlign}`}>
        <a
          href="#"
          aria-disabled="true"
          class="inline-flex items-center gap-3 rounded-2xl bg-forest px-6 py-3.5 text-cream shadow-soft transition-transform hover:-translate-y-0.5"
        >
          {s.icon === 'play' ? (
            <svg
              width="24"
              height="26"
              viewBox="0 0 40 44"
              aria-hidden="true"
              fill="none"
              xmlns="http://www.w3.org/2000/svg"
            >
              <path d="M1.6 1.2C1.2 1.6 1 2.3 1 3.1v37.8c0 .8.2 1.5.6 1.9L22 22 1.6 1.2z" fill="#7FA99B" />
              <path d="M1.6 1.2 22 22l6.7-6.7L4.8.4C3.6-.3 2.3-.1 1.6 1.2z" fill="#1C6B63" />
              <path d="M22 22 1.6 42.8c.7 1.3 2 1.5 3.2.8l23.9-14L22 22z" fill="#D85E36" />
              <path d="M28.7 15.3 22 22l6.7 6.7 8-4.7c1.7-1 1.7-2.9 0-3.9l-8-4.8z" fill="#F0A93B" />
            </svg>
          ) : (
            <svg
              width="24"
              height="26"
              viewBox="0 0 384 512"
              aria-hidden="true"
              fill="currentColor"
              xmlns="http://www.w3.org/2000/svg"
            >
              <path d="M318.7 268.7c-.2-36.7 16.4-64.4 50-84.8-18.8-26.9-47.2-41.7-84.7-44.6-35.5-2.8-74.3 20.7-88.5 20.7-15 0-49.4-19.7-76.4-19.7C63.3 141.2 4 184.8 4 273.5q0 39.3 14.4 81.2c12.8 36.7 59 126.7 107.2 125.2 25.2-.6 43-17.9 75.8-17.9 31.8 0 48.3 17.9 76.4 17.9 48.6-.7 90.4-82.5 102.6-119.3-65.2-30.7-61.7-90-61.7-91.9zm-56.6-164.2c27.3-32.4 24.8-61.9 24-72.5-24.1 1.4-52 16.4-67.9 34.9-17.5 19.8-27.8 44.3-25.6 71.9 26.1 2 49.9-11.4 69.5-34.3z" />
            </svg>
          )}
          <span class="text-left leading-tight">
            <span class="block text-xs uppercase tracking-wide text-mist/80">{s.label}</span>
            <span class="block text-lg font-semibold">{s.name}</span>
          </span>
        </a>
        <span class="text-xs font-medium text-soft">{s.note}</span>
      </div>
    ))
  }
</div>
