---
// Soft concentric arcs — a calm, organic background motif echoing the brand's
// "soft sunrise / ripples" language. Purely decorative.
interface Props {
  class?: string;
}
const { class: className = '' } = Astro.props;
---
<svg
  class={`pointer-events-none select-none ${className}`}
  viewBox="0 0 600 600"
  fill="none"
  aria-hidden="true"
  focusable="false"
  xmlns="http://www.w3.org/2000/svg"
>
  <g stroke="#7FA99B" stroke-opacity="0.35" stroke-width="1.5" fill="none">
    <circle cx="300" cy="300" r="90" />
    <circle cx="300" cy="300" r="160" />
    <circle cx="300" cy="300" r="230" />
    <circle cx="300" cy="300" r="300" />
  </g>
  <circle cx="300" cy="300" r="34" fill="#D85E36" fill-opacity="0.85" />
</svg>
