---
import FullStop from './FullStop.astro';
import Sprout from './Sprout.astro';
const year = 2026; // Date APIs are unavailable at build time here; bump on the next release.
---
<footer class="mt-20 border-t border-hairline bg-mist/50">
  <div class="container-prose py-12">
    <!-- Crisis path — always reachable, never buried. -->
    <div
      class="mb-8 rounded-2xl border border-hairline bg-cream p-5 text-center shadow-card sm:text-left"
    >
      <p class="text-sm text-soft sm:text-base">
        <span class="font-semibold text-forest">In crisis or need to talk now?</span>
        You're not alone — free, confidential help is available any time.
        <a
          href="/support#crisis"
          class="font-semibold text-terracotta underline underline-offset-2 hover:text-coral"
          >Get help now</a
        >.
      </p>
    </div>

    <div class="flex flex-col gap-8 sm:flex-row sm:items-start sm:justify-between">
      <div class="max-w-sm">
        <div class="flex items-center gap-3">
          <Sprout class="h-11 w-auto text-forest" />
          <img
            src="/assets/wordmark.png"
            alt="Befree"
            width="264"
            height="100"
            class="h-11 w-auto"
            decoding="async"
          />
        </div>
        <p class="mt-3 text-sm leading-relaxed text-soft">
          A kinder way to put the phone down. Free, private, no ads.
        </p>
      </div>

      <nav aria-label="Footer" class="text-sm">
        <ul class="flex flex-wrap gap-x-6 gap-y-2">
          <li>
            <a href="/plus" class="text-soft hover:text-forest">BeFree Plus</a>
          </li>
          <li>
            <a href="/privacy" class="text-soft hover:text-forest">Privacy</a>
          </li>
          <li>
            <a href="/delete-account" class="text-soft hover:text-forest">Delete account</a>
          </li>
          <li>
            <a href="/support" class="text-soft hover:text-forest">Support &amp; contact</a>
          </li>
          <li>
            <a href="/support#crisis" class="text-soft hover:text-forest">Crisis help</a>
          </li>
        </ul>
      </nav>
    </div>

    <!-- Not medical treatment — required disclaimer, on every page. -->
    <p class="mt-10 max-w-2xl text-xs leading-relaxed text-soft">
      BeFree is a support tool, not medical treatment. It does not provide medical or
      clinical advice and is not a substitute for care from a qualified professional. If
      you are struggling, please reach out to a professional or one of the
      <a href="/support#crisis" class="underline underline-offset-2 hover:text-forest"
        >crisis resources</a
      >.
    </p>

    <div class="mt-6 flex items-center gap-2 text-xs text-soft">
      <img
        src="/assets/wordmark.png"
        alt="Befree"
        width="264"
        height="100"
        class="h-6 w-auto opacity-70"
        decoding="async"
      />
      <span>© {year} · Be free<FullStop /></span>
    </div>
    <p class="mt-2 text-xs text-soft">
      Befree is made by Ethicaa Ltd, registered in England &amp; Wales, company no. 17331429.
    </p>
  </div>
</footer>
