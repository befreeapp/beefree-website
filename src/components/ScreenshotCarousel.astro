---
// A gentle, continuously-scrolling carousel of app screenshots.
// CSS marquee (two identical groups sliding -50%, seamless loop). Pauses on
// hover/focus and while the lightbox is open; falls back to a plain scroll for
// reduced-motion. Tap any frame to open it large in a lightbox you can page
// through with arrows / swipe-style buttons.
const shots = [
  { src: '/assets/screenshot-01.png', alt: 'BeFree home screen showing the daily check-in and streak.' },
  { src: '/assets/screenshot-02.png', alt: 'A warm chat with the AI companion, Atlas.' },
  { src: '/assets/screenshot-03.png', alt: 'App and content blocking settings with schedules and places.' },
  { src: '/assets/screenshot-04.png', alt: 'The support library with help and resources.' },
  { src: '/assets/screenshot-05.png', alt: 'The BeFree Plus screen with its features and pricing.' },
];
const groups = [
  { items: shots, hidden: false },
  { items: shots, hidden: true },
];
---
<section class="py-2" aria-label="A look inside BeFree">
  <div class="marquee group">
    <div class="marquee__track" data-marquee-track>
      {
        groups.map((g) => (
          <ul class="marquee__group" aria-hidden={g.hidden ? 'true' : undefined}>
            {g.items.map((s, i) => (
              <li class="marquee__item">
                <button
                  type="button"
                  class="block cursor-zoom-in rounded-2xl transition-transform hover:-translate-y-1 focus-visible:-translate-y-1"
                  data-shot
                  data-index={i}
                  aria-hidden={g.hidden ? 'true' : undefined}
                  tabindex={g.hidden ? -1 : undefined}
                  aria-label={g.hidden ? undefined : `Expand: ${s.alt}`}
                >
                  <img
                    src={s.src}
                    alt={g.hidden ? '' : s.alt}
                    width="270"
                    height="480"
                    loading="eager"
                    decoding="async"
                    class="h-auto w-72 rounded-2xl border border-hairline shadow-card sm:w-80"
                  />
                </button>
              </li>
            ))}
          </ul>
        ))
      }
    </div>
  </div>
  <p class="mt-3 text-center text-xs text-soft">Tap a screen to take a closer look.</p>
</section>

<!-- Lightbox -->
<div class="lightbox" data-lightbox hidden>
  <button class="lightbox__backdrop" data-close aria-label="Close"></button>
  <div class="lightbox__panel" role="dialog" aria-modal="true" aria-label="App screenshot">
    <button class="lightbox__nav lightbox__nav--prev" data-prev aria-label="Previous screenshot">
      <span aria-hidden="true">‹</span>
    </button>
    <img class="lightbox__img" data-lightbox-img src="" alt="" />
    <button class="lightbox__nav lightbox__nav--next" data-next aria-label="Next screenshot">
      <span aria-hidden="true">›</span>
    </button>
    <button class="lightbox__close" data-close aria-label="Close">
      <span aria-hidden="true">×</span>
    </button>
  </div>
</div>

<style>
  .marquee {
    overflow: hidden;
    -webkit-mask-image: linear-gradient(
      to right,
      transparent,
      #000 5%,
      #000 95%,
      transparent
    );
    mask-image: linear-gradient(to right, transparent, #000 5%, #000 95%, transparent);
  }
  .marquee__track {
    display: flex;
    width: max-content;
    animation: marquee-scroll 60s linear infinite;
  }
  .marquee:hover .marquee__track,
  .marquee:focus-within .marquee__track,
  .marquee__track[data-paused] {
    animation-play-state: paused;
  }
  .marquee__group {
    display: flex;
    margin: 0;
    padding: 0.75rem 0;
    list-style: none;
  }
  .marquee__item {
    flex: none;
    padding-left: 0.6rem;
    padding-right: 0.6rem;
  }
  @keyframes marquee-scroll {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(-50%);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .marquee {
      overflow-x: auto;
      -webkit-mask-image: none;
      mask-image: none;
    }
    .marquee__track {
      animation: none;
    }
    .marquee__group[aria-hidden='true'] {
      display: none;
    }
  }

  /* Lightbox */
  .lightbox {
    position: fixed;
    inset: 0;
    z-index: 60;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1.5rem;
    background: rgba(15, 61, 57, 0.82);
    -webkit-backdrop-filter: blur(4px);
    backdrop-filter: blur(4px);
    animation: lightbox-in 0.2s ease both;
  }
  .lightbox[hidden] {
    display: none;
  }
  .lightbox__backdrop {
    position: absolute;
    inset: 0;
    border: 0;
    background: transparent;
    cursor: zoom-out;
  }
  .lightbox__panel {
    position: relative;
    display: flex;
    align-items: center;
    gap: 0.75rem;
    max-height: 92vh;
  }
  .lightbox__img {
    display: block;
    max-height: 92vh;
    width: auto;
    border-radius: 1.5rem;
    box-shadow: 0 24px 60px -20px rgba(0, 0, 0, 0.5);
    animation: lightbox-pop 0.22s ease both;
  }
  .lightbox__nav,
  .lightbox__close {
    display: flex;
    align-items: center;
    justify-content: center;
    color: #0f3d39;
    background: #fbf6ec;
    border: 0;
    border-radius: 9999px;
    box-shadow: 0 6px 18px -6px rgba(0, 0, 0, 0.4);
    cursor: pointer;
  }
  .lightbox__nav {
    flex: none;
    width: 3rem;
    height: 3rem;
    font-size: 2rem;
    line-height: 1;
  }
  /* On phones, float the arrows over the image edges to save width. */
  @media (max-width: 640px) {
    .lightbox__nav {
      position: absolute;
      top: 50%;
      transform: translateY(-50%);
      width: 2.75rem;
      height: 2.75rem;
    }
    .lightbox__nav--prev {
      left: -0.25rem;
    }
    .lightbox__nav--next {
      right: -0.25rem;
    }
  }
  .lightbox__close {
    position: absolute;
    top: -0.75rem;
    right: -0.75rem;
    width: 2.5rem;
    height: 2.5rem;
    font-size: 1.6rem;
    line-height: 1;
  }
  @keyframes lightbox-in {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }
  @keyframes lightbox-pop {
    from {
      opacity: 0;
      transform: scale(0.96);
    }
    to {
      opacity: 1;
      transform: scale(1);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .lightbox,
    .lightbox__img {
      animation: none;
    }
  }
</style>

<script>
  const lightbox = document.querySelector('[data-lightbox]') as HTMLElement | null;
  const lightboxImg = document.querySelector('[data-lightbox-img]') as HTMLImageElement | null;
  const track = document.querySelector('[data-marquee-track]') as HTMLElement | null;

  // The ordered, unique gallery comes from the first (visible) group.
  const gallery = Array.from(
    document.querySelectorAll<HTMLImageElement>(
      '.marquee__group:not([aria-hidden]) [data-shot] img'
    )
  ).map((img) => ({ src: img.getAttribute('src') || '', alt: img.getAttribute('alt') || '' }));

  let current = 0;
  let openedByKeyboard = false;
  let lastFocused: HTMLElement | null = null;

  function render() {
    if (!lightboxImg) return;
    const shot = gallery[current];
    if (!shot) return;
    lightboxImg.src = shot.src;
    lightboxImg.alt = shot.alt;
  }

  function openLightbox(index: number, viaKeyboard: boolean) {
    if (!lightbox) return;
    current = (index + gallery.length) % gallery.length;
    openedByKeyboard = viaKeyboard;
    lastFocused = document.activeElement as HTMLElement;
    render();
    lightbox.hidden = false;
    document.body.style.overflow = 'hidden';
    track?.setAttribute('data-paused', '');
    (lightbox.querySelector('.lightbox__close') as HTMLElement | null)?.focus();
  }

  function closeLightbox() {
    if (!lightbox || !lightboxImg) return;
    lightbox.hidden = true;
    lightboxImg.src = '';
    document.body.style.overflow = '';
    track?.removeAttribute('data-paused');
    // Returning focus into the carousel would keep it paused (:focus-within).
    // Only do that for keyboard users; pointer users get the scroll resumed.
    if (openedByKeyboard) {
      lastFocused?.focus();
    } else {
      (document.activeElement as HTMLElement | null)?.blur();
    }
  }

  function step(delta: number) {
    current = (current + delta + gallery.length) % gallery.length;
    render();
  }

  document.querySelectorAll<HTMLElement>('[data-shot]').forEach((btn) => {
    btn.addEventListener('click', (e) => {
      const index = Number(btn.dataset.index || 0);
      openLightbox(index, (e as MouseEvent).detail === 0);
    });
  });
  lightbox?.querySelectorAll('[data-close]').forEach((el) =>
    el.addEventListener('click', closeLightbox)
  );
  lightbox?.querySelector('[data-prev]')?.addEventListener('click', () => step(-1));
  lightbox?.querySelector('[data-next]')?.addEventListener('click', () => step(1));

  document.addEventListener('keydown', (e) => {
    if (!lightbox || lightbox.hidden) return;
    if (e.key === 'Escape') closeLightbox();
    else if (e.key === 'ArrowLeft') step(-1);
    else if (e.key === 'ArrowRight') step(1);
  });
</script>
