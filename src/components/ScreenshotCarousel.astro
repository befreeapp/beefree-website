---
// A gentle, continuously-scrolling carousel of app screenshots.
// CSS marquee (two identical groups sliding -50%, seamless loop). Pauses on
// hover/focus and while the lightbox is open; on phones it becomes a swipeable
// snap-scroller instead. Tap any frame to open it in the shared lightbox.
// The current Play Store screenshots, in upload order.
const shots = [
  { src: '/assets/shot-01-check-in.webp', alt: 'The BeFree home screen, with the daily check-in and your streak.' },
  { src: '/assets/shot-02-companion.webp', alt: 'A warm conversation with the AI companion, Atlas.' },
  { src: '/assets/shot-03-blocking.webp', alt: 'App and content blocking — schedules, places and an adult-content filter.' },
  { src: '/assets/shot-04-support.webp', alt: 'The support library: counselling directories, articles and crisis lines.' },
  { src: '/assets/shot-05-plus.webp', alt: 'The optional BeFree Plus screen, with its features and pricing.' },
];
const groups = [
  { items: shots, hidden: false },
  { items: shots, hidden: true },
];
---
<section class="py-2" aria-label="A look inside BeFree">
  <div class="marquee group">
    <div class="marquee__track" data-marquee-track>
      {
        groups.map((g) => (
          <ul class="marquee__group" aria-hidden={g.hidden ? 'true' : undefined}>
            {g.items.map((s, i) => (
              <li class="marquee__item">
                <button
                  type="button"
                  class="block cursor-zoom-in rounded-2xl transition-transform hover:-translate-y-1 focus-visible:-translate-y-1"
                  data-shot
                  data-gallery="app"
                  data-index={i}
                  data-src={s.src}
                  data-alt={s.alt}
                  aria-hidden={g.hidden ? 'true' : undefined}
                  tabindex={g.hidden ? -1 : undefined}
                  aria-label={g.hidden ? undefined : `Expand: ${s.alt}`}
                >
                  <img
                    src={s.src}
                    alt={g.hidden ? '' : s.alt}
                    width="270"
                    height="480"
                    loading="eager"
                    decoding="async"
                    class="h-auto w-72 rounded-2xl border border-hairline shadow-card sm:w-80"
                  />
                </button>
              </li>
            ))}
          </ul>
        ))
      }
    </div>
  </div>
  <p class="mt-3 text-center text-xs text-soft">Tap a screen to take a closer look.</p>
</section>

<style>
  .marquee {
    overflow: hidden;
    -webkit-mask-image: linear-gradient(to right, transparent, #000 5%, #000 95%, transparent);
    mask-image: linear-gradient(to right, transparent, #000 5%, #000 95%, transparent);
  }
  .marquee__track {
    display: flex;
    width: max-content;
    animation: marquee-scroll 60s linear infinite;
  }
  .marquee:hover .marquee__track,
  .marquee:focus-within .marquee__track,
  .marquee__track[data-paused] {
    animation-play-state: paused;
  }
  .marquee__group {
    display: flex;
    margin: 0;
    padding: 0.75rem 0;
    list-style: none;
  }
  .marquee__item {
    flex: none;
    padding-left: 0.6rem;
    padding-right: 0.6rem;
  }
  @keyframes marquee-scroll {
    from { transform: translateX(0); }
    to { transform: translateX(-50%); }
  }
  @media (prefers-reduced-motion: reduce) {
    .marquee {
      overflow-x: auto;
      -webkit-mask-image: none;
      mask-image: none;
    }
    .marquee__track { animation: none; }
    .marquee__group[aria-hidden='true'] { display: none; }
  }

  /* On phones: swipe through the screenshots instead of auto-scrolling. */
  @media (max-width: 767px) {
    .marquee {
      overflow-x: auto;
      scroll-snap-type: x proximity;
      scroll-padding: 0 1rem;
      -webkit-overflow-scrolling: touch;
      -webkit-mask-image: none;
      mask-image: none;
      scrollbar-width: none;
    }
    .marquee::-webkit-scrollbar { display: none; }
    .marquee__track { animation: none; }
    .marquee__group[aria-hidden='true'] { display: none; }
    .marquee__item { scroll-snap-align: center; }
  }
</style>
