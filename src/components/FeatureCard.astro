---
import Sprout from './Sprout.astro';
interface Props {
  icon: string;
  title: string;
  body: string;
  // When 'sprout', render the brand sprout mark instead of an emoji glyph.
  iconType?: 'emoji' | 'sprout';
  // Optional small pill (e.g. "Plus") shown top-right.
  badge?: string;
  // Position in a list, used to stagger the scroll-reveal animation.
  index?: number;
}
const { icon, title, body, iconType = 'emoji', badge, index = 0 } = Astro.props;
---
<div
  class="reveal relative h-full rounded-3xl border border-hairline bg-white/70 p-6 shadow-card transition-shadow hover:shadow-soft"
  style={`--reveal-delay:${index * 90}ms`}
>
  {
    badge && (
      <span class="absolute right-4 top-4 rounded-full bg-mist px-2.5 py-0.5 text-xs font-semibold text-teal">
        {badge}
      </span>
    )
  }
  {
    iconType === 'sprout' ? (
      <Sprout class="h-9 w-auto text-teal" />
    ) : (
      <span class="text-3xl" aria-hidden="true">
        {icon}
      </span>
    )
  }
  <h3 class="mt-3 text-xl">{title}</h3>
  <p class="mt-2 text-[0.95rem] leading-relaxed text-soft">{body}</p>
</div>
