---
// One lightbox, shared by every gallery on the page. Any element marked
// `data-shot data-gallery="<name>" data-index data-src data-alt` opens it, and
// the arrows page through that gallery only.
---
<div class="lightbox" data-lightbox hidden>
  <button class="lightbox__backdrop" data-close aria-label="Close"></button>
  <div class="lightbox__panel" role="dialog" aria-modal="true" aria-label="Image viewer">
    <button class="lightbox__nav lightbox__nav--prev" data-prev aria-label="Previous">
      <span aria-hidden="true">‹</span>
    </button>
    <img class="lightbox__img" data-lightbox-img src="" alt="" />
    <button class="lightbox__nav lightbox__nav--next" data-next aria-label="Next">
      <span aria-hidden="true">›</span>
    </button>
    <button class="lightbox__close" data-close aria-label="Close">
      <span aria-hidden="true">×</span>
    </button>
  </div>
</div>

<style>
  .lightbox {
    position: fixed;
    inset: 0;
    z-index: 60;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1.5rem;
    background: rgba(15, 61, 57, 0.82);
    -webkit-backdrop-filter: blur(4px);
    backdrop-filter: blur(4px);
    animation: lightbox-in 0.2s ease both;
  }
  .lightbox[hidden] {
    display: none;
  }
  .lightbox__backdrop {
    position: absolute;
    inset: 0;
    border: 0;
    background: transparent;
    cursor: zoom-out;
  }
  .lightbox__panel {
    position: relative;
    display: flex;
    align-items: center;
    gap: 0.75rem;
    max-height: 92vh;
  }
  .lightbox__img {
    display: block;
    max-height: 92vh;
    max-width: min(92vw, 900px);
    width: auto;
    border-radius: 1.5rem;
    box-shadow: 0 24px 60px -20px rgba(0, 0, 0, 0.5);
    animation: lightbox-pop 0.22s ease both;
  }
  .lightbox__nav,
  .lightbox__close {
    display: flex;
    align-items: center;
    justify-content: center;
    color: #0f3d39;
    background: #fbf6ec;
    border: 0;
    border-radius: 9999px;
    box-shadow: 0 6px 18px -6px rgba(0, 0, 0, 0.4);
    cursor: pointer;
  }
  .lightbox__nav {
    flex: none;
    width: 3rem;
    height: 3rem;
    font-size: 2rem;
    line-height: 1;
  }
  @media (max-width: 640px) {
    .lightbox__nav {
      position: absolute;
      top: 50%;
      transform: translateY(-50%);
      width: 2.75rem;
      height: 2.75rem;
    }
    .lightbox__nav--prev { left: -0.25rem; }
    .lightbox__nav--next { right: -0.25rem; }
  }
  .lightbox__close {
    position: absolute;
    top: -0.75rem;
    right: -0.75rem;
    width: 2.5rem;
    height: 2.5rem;
    font-size: 1.6rem;
    line-height: 1;
  }
  @keyframes lightbox-in {
    from { opacity: 0; }
    to { opacity: 1; }
  }
  @keyframes lightbox-pop {
    from { opacity: 0; transform: scale(0.96); }
    to { opacity: 1; transform: scale(1); }
  }
  @media (prefers-reduced-motion: reduce) {
    .lightbox,
    .lightbox__img { animation: none; }
  }
</style>

<script>
  const lightbox = document.querySelector('[data-lightbox]') as HTMLElement | null;
  const lightboxImg = document.querySelector('[data-lightbox-img]') as HTMLImageElement | null;
  let items: { src: string; alt: string }[] = [];
  let current = 0;
  let openedByKeyboard = false;
  let lastFocused: HTMLElement | null = null;

  // Build the gallery from the visible (non-duplicated) triggers of that name.
  function collect(name: string) {
    return Array.from(
      document.querySelectorAll<HTMLElement>(`[data-shot][data-gallery="${name}"]`)
    )
      .filter((el) => el.getAttribute('aria-hidden') !== 'true')
      .map((el) => ({ src: el.dataset.src || '', alt: el.dataset.alt || '' }));
  }

  function render() {
    if (!lightboxImg) return;
    const shot = items[current];
    if (!shot) return;
    lightboxImg.src = shot.src;
    lightboxImg.alt = shot.alt;
  }

  function open(name: string, index: number, viaKeyboard: boolean) {
    if (!lightbox) return;
    items = collect(name);
    if (!items.length) return;
    current = (index + items.length) % items.length;
    openedByKeyboard = viaKeyboard;
    lastFocused = document.activeElement as HTMLElement;
    render();
    lightbox.hidden = false;
    document.body.style.overflow = 'hidden';
    (lightbox.querySelector('.lightbox__close') as HTMLElement | null)?.focus();
  }

  function close() {
    if (!lightbox || !lightboxImg) return;
    lightbox.hidden = true;
    lightboxImg.src = '';
    document.body.style.overflow = '';
    // Only keyboard users get their focus put back; a pointer user shouldn't
    // be left with a highlighted thumbnail.
    if (openedByKeyboard) lastFocused?.focus();
    else (document.activeElement as HTMLElement | null)?.blur();
  }

  function step(delta: number) {
    if (!items.length) return;
    current = (current + delta + items.length) % items.length;
    render();
  }

  document.querySelectorAll<HTMLElement>('[data-shot]').forEach((el) => {
    el.addEventListener('click', (e) => {
      open(el.dataset.gallery || '', Number(el.dataset.index || 0), (e as MouseEvent).detail === 0);
    });
  });
  lightbox?.querySelectorAll('[data-close]').forEach((el) => el.addEventListener('click', close));
  lightbox?.querySelector('[data-prev]')?.addEventListener('click', () => step(-1));
  lightbox?.querySelector('[data-next]')?.addEventListener('click', () => step(1));
  document.addEventListener('keydown', (e) => {
    if (!lightbox || lightbox.hidden) return;
    if (e.key === 'Escape') close();
    else if (e.key === 'ArrowLeft') step(-1);
    else if (e.key === 'ArrowRight') step(1);
  });
</script>
