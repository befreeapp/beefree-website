---
const { pathname } = Astro.url;
const isActive = (href: string) =>
  href === '/' ? pathname === '/' : pathname.startsWith(href);

const navLinks = [
  { href: '/', label: 'Home' },
  { href: '/plus', label: 'Plus' },
  { href: '/support', label: 'Support' },
  { href: '/privacy', label: 'Privacy' },
];
---
<header class="w-full">
  <nav
    class="container-prose flex items-center justify-between py-4"
    aria-label="Primary"
  >
    <a href="/" class="flex items-center gap-2.5" aria-label="Befree — home">
      <!-- App-icon tile beside the wordmark, as the campaign locks it up. -->
      <img
        src="/assets/icon-tile.webp"
        alt=""
        width="128"
        height="128"
        class="h-8 w-8 rounded-[0.55rem] sm:h-9 sm:w-9 sm:rounded-[0.6rem]"
        decoding="async"
      />
      <img
        src="/assets/wordmark.png"
        alt="Befree"
        width="264"
        height="100"
        class="h-8 w-auto sm:h-10"
        decoding="async"
      />
    </a>
    <ul class="flex items-center gap-4 text-sm font-medium sm:gap-7 sm:text-base">
      {
        navLinks.map((link) => (
          <li class:list={[link.href === '/' && 'hidden sm:block']}>
            <a
              href={link.href}
              class:list={[
                'transition-colors hover:text-forest',
                isActive(link.href) ? 'text-forest font-semibold' : 'text-soft',
              ]}
              aria-current={isActive(link.href) ? 'page' : undefined}
            >
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>
